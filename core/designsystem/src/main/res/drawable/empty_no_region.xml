<?xml version="1.0" encoding="utf-8"?>
<!--
  Empty-state illustration: no offline region downloaded. A faint map outline with a
  download arrow overlaid — communicates "you need to fetch something to begin".
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="200dp"
    android:height="120dp"
    android:viewportWidth="200"
    android:viewportHeight="120">
    <!-- Faint map card -->
    <path android:strokeColor="#3A3F45" android:strokeWidth="2" android:fillColor="#00000000" android:pathData="M10,10 h180 v100 h-180 z" />
    <!-- Faint grid -->
    <path android:strokeColor="#2A3138" android:strokeWidth="1" android:pathData="M55,10 v100 M100,10 v100 M145,10 v100 M10,35 h180 M10,60 h180 M10,85 h180" />
    <!-- Download arrow -->
    <path android:strokeColor="#66BB6A" android:strokeWidth="4" android:strokeLineCap="round" android:fillColor="#00000000" android:pathData="M100,40 L100,75 M85,60 L100,75 L115,60" />
    <path android:strokeColor="#66BB6A" android:strokeWidth="4" android:strokeLineCap="round" android:fillColor="#00000000" android:pathData="M75,90 h50" />
</vector>
