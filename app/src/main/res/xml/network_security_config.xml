<?xml version="1.0" encoding="utf-8"?>
<!--
  Network security policy.

  Default: HTTPS-only (the Android 9+ default), which protects against MITM on the
  production manifest URL.

  Local-dev exception: cleartext HTTP is permitted for 10.0.2.2 (the emulator's alias
  for the host machine). This lets the app reach the backend pipeline's local
  `python -m http.server` without configuring TLS. The exception is scoped — random
  cleartext URLs are still rejected.

  Production: remove the <domain-config> below once the manifest is served over HTTPS.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">10.0.2.2</domain>
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
        <domain includeSubdomains="true">72.56.238.106</domain>
        <domain includeSubdomains="true">2circle.ru</domain>
    </domain-config>
</network-security-config>
